{
  "permissions": {
    "deny": [
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/**/.env.*.local)",
      "Read(/**/.env.development)",
      "Read(/**/.env.production)",
      "Read(/**/.env.staging)",
      "Read(/**/.env.test)",
      "Read(/**/.dev.vars)",
      "Read(/**/.dev.vars.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-push-guard.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
